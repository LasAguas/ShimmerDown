# Copy to .env.local for local dev, and set the same values in Vercel →
# Project → Settings → Environment Variables.

# The Las Aguas dashboard. Only change this to point at a staging deploy.
LAS_AGUAS_API=https://lasaguasproductions.com

# Webstore (Dashboard → Admin → Webstore). The store must be PUBLISHED or the
# API answers 404 and the shop shows its "not open yet" state.
STORE_SLUG=shimmer-down-studios-store

# Newsletter form (Dashboard → Mailing → Forms).
NEWSLETTER_FORM_SLUG=newsletter-sign-up-zdr1
NEWSLETTER_FORM_ID=984a0ce6-030e-4f5e-a79d-cdf6fa5cc398

# Where Stripe sends the buyer back after paying. Must be the live origin in
# production, and the hostname must be on the dashboard's
# STORE_RETURN_URL_ALLOWLIST or buyers land on lasaguasproductions.com instead.
SITE_ORIGIN=http://localhost:3000
